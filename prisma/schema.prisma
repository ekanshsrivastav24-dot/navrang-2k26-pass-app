datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Pass {
  id                    String    @id @default(uuid())
  passCode              String    @unique
  attendeeName          String
  email                 String
  phone                 String
  category              String
  university            String?
  rollNumber            String?
  collegeName           String?
  govtId                String?
  stickQuantity         Int       @default(0)
  amountPaid            Float
  paymentId             String
  paymentStatus         String    @default("PAID")
  status                String    @default("VALID")
  signature             String
  checkedInAt           DateTime?
  checkedInByGate       String?
  checkedInByVolunteer  String?
  notes                 String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  logs                  GateLog[]
}

model GateLog {
  id          String   @id @default(uuid())
  passId      String?
  passCode    String?
  action      String
  message     String
  gate        String
  volunteer   String?
  createdAt   DateTime @default(now())
  pass        Pass?    @relation(fields: [passId], references: [id], onDelete: SetNull)
}

model EventSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
